# Copiar a .env y completar. El archivo .env NO se versiona.

# --- RabbitMQ, conexion AMQP (escrituras) ---
# Ojo con el nombre de la contrasena: application.yml lee RABBITMQ_PASS, mientras que el .env
# compartido de infra usa RABBITMQ_PASSWORD y el compose hace el mapeo entre ambos. Para ejecutar
# este servicio de forma autonoma hay que definir RABBITMQ_PASS, o la conexion sale sin contrasena
# y el broker responde ACCESS_REFUSED.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=andesstay
RABBITMQ_USER=andesstay
RABBITMQ_PASS=cambiar_esto

# --- RabbitMQ, API de gestion (lecturas de inventario) ---
# El puerto 15672 es lo UNICO que permite listar: el protocolo AMQP no define ninguna operacion de
# listado. Si esta URL no es alcanzable, las altas y las bajas siguen funcionando y los GET de
# listado devuelven 503.
#
# El usuario necesita la etiqueta "administrator" en el broker para poder leer /api. El que crea
# RABBITMQ_DEFAULT_USER ya la tiene, asi que se reutilizan las credenciales de arriba.
#
# En el compose, el valor es http://rabbitmq1:15672 porque el contenedor comparte la red del
# broker; el puerto se publica solo en loopback y no esta abierto al exterior.
RABBITMQ_MGMT_URL=http://localhost:15672

# --- Entra ID ---
# Mismo tenant y mismo registro de aplicacion que el resto del sistema. Todas las rutas exigen el
# rol Admin del token.
AZURE_TENANT_ID=055d11d1-8ae0-4221-a6f7-b50be0a623b4
AZURE_CLIENT_ID=704a544f-3d92-44f5-aef9-8559574cff34

# La lista de recursos protegidos (andesstay.mq.protegidos) NO se expone como variable de entorno a
# proposito: desactivar el seguro por configuracion seria perder justo lo que aporta. Para una
# operacion destructiva intencionada esta el parametro ?forzar=true.
